# ThreatEye — environment configuration
# Copy to `.env` (which is git-ignored) and fill in real values before deploying.
# `docker compose` picks this file up automatically.

# ------------------------------------------------------------------------------
# Secrets (CHANGE THESE — never ship the defaults)
# ------------------------------------------------------------------------------
# Signs the dashboard session tokens. If left unset, the backend auto-generates a
# random secret and persists it in the DB. Set it explicitly when you run more than
# one backend replica so every replica signs/validates with the same key.
THREATEYE_AUTH_SECRET=

# PostgreSQL credentials (used by both the db service and the backend DATABASE_URL).
POSTGRES_DB=threateye
POSTGRES_USER=threateye
POSTGRES_PASSWORD=change-this-postgres-password

# ------------------------------------------------------------------------------
# Auth / session (JWT access + refresh in httpOnly cookies)
# ------------------------------------------------------------------------------
ACCESS_TOKEN_TTL_SECONDS=900             # access token lifetime (15 min)
REFRESH_TOKEN_TTL_SECONDS=604800         # refresh token lifetime (7 days)
COOKIE_SECURE=false                      # set true when serving over HTTPS
COOKIE_SAMESITE=lax                      # lax | strict | none
THREATEYE_LOGIN_MAX_ATTEMPTS=8           # failed logins per IP before a temporary block
THREATEYE_LOGIN_WINDOW_SECONDS=300       # sliding window (seconds) for the counter above

# ------------------------------------------------------------------------------
# AI model provider (Ollama or any OpenAI-compatible endpoint)
# ------------------------------------------------------------------------------
AI_MODEL=glm-4.5
OLLAMA_MODEL=glm-4.5
OPENAI_API_KEY=ollama
OPENAI_API_BASE=http://ollama:11434/v1

# ------------------------------------------------------------------------------
# Integrations
# ------------------------------------------------------------------------------
GOPHISH_API_KEY=
GOPHISH_VERIFY_TLS=false                 # set true when GoPhish has a real certificate
SIEM_WEBHOOK_URL=                        # SIEM/HEC endpoint (also settable in the SOC panel)
SIEM_API_KEY=                            # SIEM token/key (also settable in the SOC panel)
SIEM_AUTH_HEADER=Authorization           # header to carry the key (e.g. Authorization, DD-API-KEY)
SIEM_AUTH_PREFIX=Bearer                  # value prefix: "Bearer " | "Splunk " | "ApiKey " | "" (Datadog)
SIEM_FORMAT=raw                          # raw | ecs | ocsf (also settable in-app)

# Phishing simulation (GoPhish) — defaults target the bundled lab services.
SIM_SMTP_HOST=mail_server:25             # SMTP relay GoPhish sends through
SIM_SMTP_FROM=IT Security <it-security@example.com>
SIM_PHISH_URL=http://localhost           # base URL of the GoPhish phishing/landing server

# ------------------------------------------------------------------------------
# Platform
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0           # shared state (login rate-limit) across replicas
CLAMAV_TCP=                              # optional clamd host:port for attachment scanning
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Web
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
